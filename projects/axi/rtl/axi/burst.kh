// Shared AXI address/lane arithmetic for every protocol of axi.types. Fields
// are read through the configuration's accessors (an AXI4-Lite request is a
// single full-width INCR beat). All runtime wrapping below is a power-of-two
// bit mask; no arbitrary runtime modulo is required.
pub fn valid_request(C: type, request: any) -> bool {
    val size = C.size_of(request);
    val burst = C.burst_of(request);
    val cache = C.cache_of(request);
    val bytes = 1 << size;
    val count = C.len_of(request) + 1;
    // Mask, not subtract: a full-width subtraction is a long carry chain.
    val aligned = request.addr & (2**C.addr_width - bytes);
    var valid = size <= C.size && bytes <= 2**C.addr_width && burst <= C.wrap;
    // AxCACHE allocate bits require the Modifiable (AXI3: Cacheable) bit
    // (IHI 0022H A4.4).
    valid = valid && ((cache & 2) != 0 || (cache & 12) == 0);
    // AXI3 AxLOCK value 3 is reserved.
    if (C.axi3) { valid = valid && request.lock != 3; }
    if (burst == C.fixed) { valid = valid && count <= 16; }
    if (burst == C.wrap) {
        valid = valid && (count == 2 || count == 4 || count == 8 || count == 16)
            && (request.addr & (bytes - 1)) == 0 && count * bytes <= 2**C.addr_width;
    }
    if (burst == C.incr) {
        // With at least 12 address bits, a burst inside one 4 KB page cannot
        // pass the top of the address space, so only narrower buses need the
        // separate full-width check.
        valid = valid && (aligned & 4095) + count * bytes <= 4096;
        if (C.addr_width < 12) { valid = valid && aligned + count * bytes <= 2**C.addr_width; }
    }
    if (C.exclusive(request)) {
        valid = valid && (count == 1 || count == 2 || count == 4 || count == 8 || count == 16)
            && count * bytes <= 128 && (request.addr & (count * bytes - 1)) == 0;
    }
    return valid;
}

pub fn beat_address(C: type, request: any, beat: uint(0..256)) -> C.Addr {
    val bytes = 1 << C.size_of(request);
    var address = request.addr;
    if (C.burst_of(request) == C.incr && beat != 0) {
        address = request.addr - (request.addr & (bytes - 1)) + beat * bytes;
    }
    if (C.burst_of(request) == C.wrap) {
        val mask = (C.len_of(request) + 1) * bytes - 1;
        address = request.addr - (request.addr & mask) + ((request.addr + beat * bytes) & mask);
    }
    return address & (2**C.addr_width - 1);
}

pub fn lane_mask(C: type, request: any, beat: uint(0..256)) -> C.Strobe {
    val address = beat_address(C, request, beat);
    val bytes = 1 << C.size_of(request);
    val lower = address & (C.bytes - 1);
    val upper = lower - (address & (bytes - 1)) + bytes;
    var strobes: C.Strobe = 0;
    for (lane in 0..C.bytes) {
        val selected = lower <= lane && lane < upper;
        if (selected) { strobes = strobes | (1 << lane); }
    }
    return strobes;
}
