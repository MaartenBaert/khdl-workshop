import channel.endpoints.[Transmitter, Receiver];
import channel.buffers.[Internal, Fifo, internal, storage];
import axi.interfaces.[Axi, ManagerChannels, manager_channels];
import axi.context.[ContextQueue, context_queue];
import axi.burst.[valid_request, lane_mask];

pub struct ReadBeat(C: type) { data: C.Data, resp: uint(2), last: bool, user: uint(C.ruser_width) }
pub struct WriteCompletion(C: type) { resp: uint(2), user: uint(C.buser_width) }
struct ReadContext { len: uint(8), lock: bool }

// Storage type for a depth, as channel.buffers.storage builds it: depth one is
// an Internal slot (same-cycle push->pop chaining), deeper ones a Fifo.
fn storage_type(T: type, depth: positive) -> type {
    if (depth == 1) { return Internal(T); }
    else { return Fifo(T, depth); }
}

pub struct ManagerReadEndpoint(C: type, endpoint_id: uint, capacity: positive, response_depth: positive,
    request_depth: positive) {
    const id = endpoint_id;
    const capacity = capacity;
    requests: storage_type(C.Ar, request_depth),
    responses: storage_type(C.R, response_depth),
    contexts: ContextQueue(ReadContext, capacity),

    fn validate(write: bool) { assert(!write, "read endpoint bound as a writer"); }
    // The Manager routes each received R beat (by RID, or by issue order on
    // AXI4-Lite) and offers it with its route; returns true when taken here.
    fn begin(self, input: Receiver(C.R), routed: bool, route: any) -> bool {
        self.requests.begin(); self.responses.begin();
        var taken = false;
        if (routed && input.can_pop()) {
            if (route == endpoint_id && self.responses.can_push()) {
                self.responses.push(input.pop());
                taken = true;
            }
        }
        return taken;
    }
    // AXI4-Lite: record the issuing endpoint, in bus order, for routing R.
    fn flush_ar(self, output: Transmitter(C.Ar), issued: any) -> bool {
        if (self.requests.can_pop() && output.can_push() && issued.can_push()) {
            output.push(self.requests.pop());
            if (C.lite) { val _ = issued.push(endpoint_id); }
            return true;
        }
        return false;
    }
    fn end(self) { self.responses.end(); self.requests.end(); }
    fn can_push(self) -> bool { return self.contexts.can_push() && self.requests.can_push(); }
    fn push(self, request: C.Ar) {
        val available = self.can_push();
        assert(available, "ManagerReadEndpoint.push(): can_push required");
        val address = C.with_id(request, endpoint_id);
        val valid = valid_request(C, address);
        assert(valid, "ManagerReadEndpoint.push(): illegal request");
        if (available && valid) {
            val _ = self.contexts.push(ReadContext.new(len=C.len_of(address), lock=C.exclusive(address)));
            self.requests.push(address);
        }
    }
    fn can_pop(self) -> bool { return self.responses.can_pop(); }
    fn peek(self) -> ReadBeat(C) {
        assert(self.can_pop(), "ManagerReadEndpoint.peek(): response required");
        var result: ReadBeat(C) = undef;
        if (self.can_pop()) {
            assert(self.contexts.can_pop(), "ManagerReadEndpoint.peek(): unexpected response");
            if (self.contexts.can_pop()) {
                val payload = self.responses.peek();
                val token = self.contexts.head;
                val descriptor = self.contexts.descriptors[token];
                val last = self.contexts.beats[token] == descriptor.len;
                assert(C.last_of(payload) == last, "ManagerReadEndpoint.peek(): RLAST does not match ARLEN");
                assert(payload.resp != C.exokay || descriptor.lock, "ManagerReadEndpoint.peek(): EXOKAY requires exclusive request");
                result = ReadBeat(C).new(data=payload.data, resp=payload.resp, last=last, user=C.user_of(payload));
            }
        }
        return result;
    }
    fn pop(self) -> ReadBeat(C) {
        val result = self.peek();
        if (self.can_pop() && self.contexts.can_pop()) {
            val _ = self.responses.pop();
            if (result.last) { self.contexts.pop(); }
            else {
                val token = self.contexts.head;
                val count = self.contexts.beats[token];
                assert(count < 256, "ManagerReadEndpoint.pop(): beat overflow");
                if (count < 256) { self.contexts.beats[token] = count + 1; }
            }
        }
        return result;
    }
}

pub struct ManagerWriteEndpoint(C: type, endpoint_id: uint, capacity: positive, response_depth: positive,
    request_depth: positive, data_depth: positive) {
    const id = endpoint_id;
    const capacity = capacity;
    requests: storage_type(C.Aw, request_depth), data: storage_type(C.W, data_depth),
    responses: storage_type(C.B, response_depth),
    contexts: ContextQueue(C.Aw, capacity),
    ref data_cursor: uint(0..capacity),
    // Final beats pushed into the local data storage and not yet forwarded to W.
    ref data_lasts: uint(0..=data_depth),

    fn validate(write: bool) { assert(write, "write endpoint bound as a reader"); }
    fn begin(self, input: Receiver(C.B), routed: bool, route: any) -> bool {
        self.requests.begin(); self.data.begin(); self.responses.begin();
        var taken = false;
        if (routed && input.can_pop()) {
            if (route == endpoint_id && self.responses.can_push()) {
                self.responses.push(input.pop());
                taken = true;
            }
        }
        return taken;
    }
    // order: W ownership (all protocols); issued: B routing (AXI4-Lite only).
    fn flush_aw(self, output: Transmitter(C.Aw), order: any, issued: any) -> bool {
        if (self.requests.can_pop() && output.can_push() && order.can_push() && issued.can_push()) {
            output.push(self.requests.pop());
            val _ = order.push(endpoint_id);
            if (C.lite) { val _ = issued.push(endpoint_id); }
            return true;
        }
        return false;
    }
    fn flush_w(self, output: Transmitter(C.W), order: any) {
        if (self.data.can_pop() && output.can_push() && order.can_pop()) {
            if (order.descriptors[order.head] == endpoint_id) {
                val beat = self.data.pop();
                output.push(beat);
                if (C.last_of(beat)) {
                    order.pop();
                    assert(self.data_lasts > 0, "ManagerWriteEndpoint: final beat count underflow");
                    if (self.data_lasts > 0) { self.data_lasts = self.data_lasts - 1; }
                }
            }
        }
    }
    // B is legal only after its burst's final W beat transferred. When the data
    // cursor is one past the head, the oldest burst is this endpoint's only
    // complete burst, so its final beat is either still in the local data
    // storage (counted by data_lasts, at any position in a deeper storage) or in
    // the shared W register when the most recently dequeued W-order entry
    // belongs to this endpoint. A live context keeps that entry from being
    // overwritten, because the order queue then cannot fill.
    fn check_response(self, output: Transmitter(C.W), order: any) {
        if (self.responses.can_pop() && self.contexts.can_pop()) {
            val head = self.contexts.head;
            var next = 0;
            if (head != capacity - 1) { next = head + 1; }
            val complete = self.contexts.beats[head] == C.len_of(self.contexts.descriptors[head]) + 1;
            if (complete && self.data_cursor == next) {
                var pending = self.data_lasts > 0;
                if (!output.can_push() && C.last_of(output.channel.data)) {
                    var previous = order.descriptors.len - 1;
                    if (order.head != 0) { previous = order.head - 1; }
                    pending = pending || order.descriptors[previous] == endpoint_id;
                }
                assert(!pending, "ManagerWriteEndpoint: B response before final W transfer");
            }
        }
    }
    fn end(self) { self.responses.end(); self.data.end(); self.requests.end(); }
    fn can_push(self) -> bool { return self.contexts.can_push() && self.requests.can_push(); }
    fn push(self, request: C.Aw) {
        val available = self.can_push();
        assert(available, "ManagerWriteEndpoint.push(): can_push required");
        val address = C.with_id(request, endpoint_id);
        val valid = valid_request(C, address);
        assert(valid, "ManagerWriteEndpoint.push(): illegal request");
        if (available && valid) {
            val _ = self.contexts.push(address);
            self.requests.push(address);
        }
    }
    fn can_push_data(self) -> bool {
        return self.contexts.contains(self.data_cursor)
            && self.contexts.beats[self.data_cursor] <= C.len_of(self.contexts.descriptors[self.data_cursor])
            && self.data.can_push();
    }
    fn push_data(self, data: C.Data, strb: C.Strobe, user: uint(C.wuser_width) = 0) -> bool {
        val available = self.can_push_data();
        assert(available, "ManagerWriteEndpoint.push_data(): can_push_data required");
        var last = false;
        if (available) {
            val token = self.data_cursor;
            val count = self.contexts.beats[token];
            val descriptor = self.contexts.descriptors[token];
            last = count == C.len_of(descriptor);
            assert(count < 256, "ManagerWriteEndpoint.push_data(): beat overflow");
            if (count < 256) {
                val mask = lane_mask(C, descriptor, count);
                assert((strb & mask) == strb, "ManagerWriteEndpoint.push_data(): invalid strobe");
                // An AXI3 W beat carries the burst's ID (WID): this endpoint's.
                self.data.push(C.make_w(endpoint_id, data, strb, last, user));
                self.contexts.beats[token] = count + 1;
                if (last) {
                    assert(self.data_lasts < data_depth, "ManagerWriteEndpoint: final beat count overflow");
                    if (self.data_lasts < data_depth) { self.data_lasts = self.data_lasts + 1; }
                }
            }
            if (last) {
                if (self.data_cursor == capacity - 1) { self.data_cursor = 0; }
                else { self.data_cursor = self.data_cursor + 1; }
            }
        }
        return last;
    }
    fn can_pop(self) -> bool { return self.responses.can_pop(); }
    fn peek(self) -> WriteCompletion(C) {
        assert(self.can_pop(), "ManagerWriteEndpoint.peek(): response required");
        var result: WriteCompletion(C) = undef;
        if (self.can_pop()) {
            assert(self.contexts.can_pop(), "ManagerWriteEndpoint.peek(): unexpected response");
            if (self.contexts.can_pop()) {
                val payload = self.responses.peek();
                val token = self.contexts.head;
                val descriptor = self.contexts.descriptors[token];
                assert(self.contexts.beats[token] == C.len_of(descriptor) + 1, "ManagerWriteEndpoint.peek(): response before write data");
                assert(payload.resp != C.exokay || C.exclusive(descriptor), "ManagerWriteEndpoint.peek(): EXOKAY requires exclusive request");
                result = WriteCompletion(C).new(resp=payload.resp, user=C.user_of(payload));
            }
        }
        return result;
    }
    fn pop(self) -> WriteCompletion(C) {
        val result = self.peek();
        if (self.can_pop() && self.contexts.can_pop()) { val _ = self.responses.pop(); self.contexts.pop(); }
        return result;
    }
}


// Endpoint constructors allocate local transaction state, independent of any
// physical bus. Their reference-bearing results can be named and composed later.
// request_depth (and data_depth for writes) one keeps the zero-latency Internal
// slot: a request pushed this cycle is forwarded to the bus at the same edge.
// Larger depths use a Fifo, which separates the application's push path from
// the bus forwarding path at the cost of one cycle.
pub fn read_endpoint(C: type, id: uint = 0, capacity: positive = 1,
    response_depth: positive = 1, request_depth: positive = 1)
    -> ManagerReadEndpoint(C, id, capacity, response_depth, request_depth) {
    // AXI4-Lite IDs are local routing labels and never appear on the bus.
    const { assert(C.lite || id < 2**C.id_width, "Manager endpoint ID exceeds bus width"); }
    return ManagerReadEndpoint(C, id, capacity, response_depth, request_depth).new(
        requests=storage(C.Ar, request_depth), responses=storage(C.R, response_depth),
        contexts=context_queue(ReadContext, capacity));
}
pub fn write_endpoint(C: type, id: uint = 0, capacity: positive = 1,
    response_depth: positive = 1, request_depth: positive = 1, data_depth: positive = 1)
    -> ManagerWriteEndpoint(C, id, capacity, response_depth, request_depth, data_depth) {
    const { assert(C.lite || id < 2**C.id_width, "Manager endpoint ID exceeds bus width"); }
    reg r_data_cursor: uint(0..capacity) = 0;
    reg r_data_lasts: uint(0..=data_depth) = 0;
    return ManagerWriteEndpoint(C, id, capacity, response_depth, request_depth, data_depth).new(
        requests=storage(C.Aw, request_depth), data=storage(C.W, data_depth),
        responses=storage(C.B, response_depth),
        contexts=context_queue(C.Aw, capacity), data_cursor=ref(r_data_cursor),
        data_lasts=ref(r_data_lasts));
}

// Tuple element metadata permits elaboration-time sizing and validation without
// evaluating any of the referenced endpoint state.
fn order_capacity(Endpoints: type) -> positive {
    var capacity = 0;
    for (F in Endpoints.elements) { capacity += F.capacity; }
    return max(1, capacity);
}
// Endpoint labels in order queues: the bus ID type, or for AXI4-Lite (no IDs)
// a range covering every endpoint's local label.
fn route_type(C: type, Reads: type, Writes: type) -> type {
    if (!C.lite) { return C.Id; }
    var limit = 1;
    for (F in Reads.elements) { limit = max(limit, F.id + 1); }
    for (F in Writes.elements) { limit = max(limit, F.id + 1); }
    return uint(0..limit);
}
// Read/B issue-order queues exist only for AXI4-Lite; elsewhere a one-entry
// queue that is never pushed stands in (no state after synthesis).
fn issue_capacity(C: type, Endpoints: type) -> positive {
    if (C.lite) { return order_capacity(Endpoints); } else { return 1; }
}
fn validate_endpoints(Endpoints: type, write: bool) {
    var index = 0;
    for (F in Endpoints.elements) {
        F.validate(write);
        var previous = 0;
        for (G in Endpoints.elements) {
            if (previous < index) { assert(F.id != G.id, "Manager endpoint IDs must be unique per direction"); }
            previous += 1;
        }
        index += 1;
    }
}

// Each tuple member keeps its concrete type. The callback shares the physical
// transmitter, whose first push closes arbitration for both passes this cycle.
// Snapshot the previous winner: updating last must not change the first mask.
fn arbitrate(endpoints: any, last: any, grant: any) {
    val previous = deref(last);
    for (pass in 0..2) {
        var index = 0;
        for (endpoint in endpoints) {
            if (pass == 1 || index > previous) {
                if (grant(endpoint)) { deref(last) = index; }
            }
            index += 1;
        }
    }
}

pub struct Manager(C: type, Reads: type, Writes: type) {
    channels: ManagerChannels(C), reads: Reads, writes: Writes,
    ref read_last: uint(0..max(1, Reads.len)),
    ref write_last: uint(0..max(1, Writes.len)),
    order: ContextQueue(route_type(C, Reads, Writes), order_capacity(Writes)),
    // AXI4-Lite only: issuing endpoint of each outstanding AR and AW, in bus
    // order. Responses return in that order and carry no ID.
    read_issued: ContextQueue(route_type(C, Reads, Writes), issue_capacity(C, Reads)),
    write_issued: ContextQueue(route_type(C, Reads, Writes), issue_capacity(C, Writes)),
    fn begin(self) {
        self.channels.begin();
        var r_routed = false;
        var r_route: route_type(C, Reads, Writes) = 0;
        if (self.channels.r.can_pop()) {
            if (C.lite) {
                assert(self.read_issued.can_pop(), "Manager.begin(): R without an outstanding AXI4-Lite read");
                if (self.read_issued.can_pop()) {
                    r_route = self.read_issued.descriptors[self.read_issued.head];
                    r_routed = true;
                }
            } else {
                val id = C.id_of(self.channels.r.peek());
                var known = false;
                for (F in Reads.elements) { known = known || id == F.id; }
                assert(known, "Manager.begin(): unknown RID");
                r_route = id;
                r_routed = true;
            }
        }
        var b_routed = false;
        var b_route: route_type(C, Reads, Writes) = 0;
        if (self.channels.b.can_pop()) {
            if (C.lite) {
                assert(self.write_issued.can_pop(), "Manager.begin(): B without an outstanding AXI4-Lite write");
                if (self.write_issued.can_pop()) {
                    b_route = self.write_issued.descriptors[self.write_issued.head];
                    b_routed = true;
                }
            } else {
                val id = C.id_of(self.channels.b.peek());
                var known = false;
                for (F in Writes.elements) { known = known || id == F.id; }
                assert(known, "Manager.begin(): unknown BID");
                b_route = id;
                b_routed = true;
            }
        }
        var r_taken = false;
        for (f in self.reads) { r_taken = f.begin(self.channels.r, r_routed, r_route) || r_taken; }
        var b_taken = false;
        for (f in self.writes) { b_taken = f.begin(self.channels.b, b_routed, b_route) || b_taken; }
        // Every AXI4-Lite response completes its transaction.
        if (C.lite && r_taken) { self.read_issued.pop(); }
        if (C.lite && b_taken) { self.write_issued.pop(); }
        for (f in self.writes) { f.check_response(self.channels.w, self.order); }
    }
    fn end(self) {
        // Forward newly submitted local beats at the same edge: Internal
        // request/data slots deliberately permit immediate push->pop chaining.
        fn grant_read(endpoint: any) -> bool { return endpoint.flush_ar(self.channels.ar, self.read_issued); }
        fn grant_write(endpoint: any) -> bool { return endpoint.flush_aw(self.channels.aw, self.order, self.write_issued); }
        arbitrate(self.reads, ref(self.read_last), grant_read);
        arbitrate(self.writes, ref(self.write_last), grant_write);
        for (f in self.writes) { f.flush_w(self.channels.w, self.order); }
        for (f in self.writes) { f.end(); }
        for (f in self.reads) { f.end(); }
        self.channels.end();
    }
}

pub fn manager(C: type, bus: RefInterface(Axi(C)),
    reads: any = (), writes: any = ()) -> Manager(C, type(reads), type(writes)) {
    type Reads = type(reads);
    type Writes = type(writes);
    const { validate_endpoints(Reads, false); validate_endpoints(Writes, true); }
    // Empty/singleton directions use a constant zero index. Initializing to the
    // final index makes endpoint zero the first candidate after reset.
    reg r_read_last: uint(0..max(1, Reads.len)) = max(1, Reads.len) - 1;
    reg r_write_last: uint(0..max(1, Writes.len)) = max(1, Writes.len) - 1;
    return Manager(C, Reads, Writes).new(channels=manager_channels(C, bus), reads=reads, writes=writes,
        read_last=ref(r_read_last), write_last=ref(r_write_last),
        order=context_queue(route_type(C, Reads, Writes), order_capacity(Writes)),
        read_issued=context_queue(route_type(C, Reads, Writes), issue_capacity(C, Reads)),
        write_issued=context_queue(route_type(C, Reads, Writes), issue_capacity(C, Writes)));
}
