// Structural port of reedsolo_forney_ent.vhd and _rtl.vhd.
// Reset is synchronous; r_ variables retain state across rising edges.
import reedsolo.[RsDefault];
import reedsolo_interfaces.[RsTransaction, RsChienBlock, RsForneyBlock];

// unroll controls arithmetic steps; unroll_chien describes the incoming positions.
pub module RsForney(unroll: positive = 1, unroll_chien: positive = 1, RS: type = RsDefault) ports(
    // clock and synchronous reset
    clk: in clock,
    sync(clk) {
        rst: in bool,
        // inputs
        input: interface RsTransaction(RsChienBlock(unroll_chien, RS=RS)).Sink,
        // outputs
        output: interface RsTransaction(RsForneyBlock(unroll_chien, RS=RS)).Source,
    }
) {
    const {
        assert(unroll <= 2 * RS.t, "forney: unroll <= 2 * RS.t");
    }
    // part 1: square inverse error locations (1 step)
    // part 2: evaluate the formal derivative (c_half_t - 1 steps)
    // part 3: adjust for the first consecutive root (1 - RS.fcr steps)
    // part 4: evaluate omega and invert denominators (RS.t steps)
    // part 5: multiply by inverse denominators (1 step)
    const c_half_t = RS.t +/ 2;
    const c_forney_steps = c_half_t - RS.fcr + RS.t + 2;
    const c_forney_cycles = c_forney_steps +/ unroll;
    wire r_input_ready_cond: sync(clk) bool;
    wire r_input_ready_uncond: sync(clk) bool;
    comb {
        input.ready = (r_input_ready_cond && output.ready) || r_input_ready_uncond;
    }
    clocked(clk, sync rst) {
        reg wire output.data = RsForneyBlock(unroll_chien, RS=RS).new(
            error_cpos=[0] * RS.t,
            error_upos=[0] * RS.t,
            error_val=[RS.sym_zero] * RS.t,
            num_errors=0,
            failed=false,
        );
        reg wire output.valid = false;
        reg wire r_input_ready_cond = true;
        reg wire r_input_ready_uncond = true;
        // output registers
        reg r_fc_output_valid: bool = false;
        // registers for processing
        reg r_terms: [RS.t + c_half_t - 2 + 1]RS.Sym = [RS.sym_zero] * (RS.t + c_half_t - 2 + 1);
        reg r_accum: [RS.t]RS.Sym = [RS.sym_zero] * RS.t;
        reg r_hold: [RS.t]RS.Sym = [RS.sym_zero] * RS.t;
        reg r_error_cpos: [RS.t]uint(RS.m) = [0] * RS.t;
        reg r_error_upos: [RS.t]uint(0..unroll_chien) = [0] * RS.t;
        reg r_error_xinv: [RS.t]RS.Sym = [RS.sym_zero] * RS.t;
        reg r_num_errors: uint(0..=RS.t) = 0;
        reg r_failed: bool = false;
        // status registers
        reg r_processing: bool = false;
        reg r_progress_counter: uint(0..c_forney_cycles) = 0;
        // store incoming block
        if (output.ready) {
            r_fc_output_valid = false;
        }
        if (input.valid && !r_processing && !r_fc_output_valid) {
            r_terms[0..RS.t] = input.data.omegas;
            for (i in 0..c_half_t - 1) {
                r_terms[RS.t + i] = input.data.lambdas[2 * i + 1];
            }
            for (i in 0..RS.t) {
                r_accum[i] = input.data.lambdas[2 * (c_half_t - 1) + 1];
            }
            r_error_cpos = input.data.error_cpos;
            r_error_upos = input.data.error_upos;
            r_error_xinv = input.data.error_xinv;
            r_num_errors = input.data.num_errors;
            r_failed = input.data.failed;
            r_processing = true;
            r_progress_counter = 0;
        }
        // process the stored block
        if (r_processing) {
            // Forney algorithm
            for (i in 0..unroll) {
                val v_iter = r_progress_counter * unroll + i;
                if (v_iter < c_forney_steps) {
                    var v_mul_a: [RS.t]RS.Sym = undef;
                    var v_mul_b: [RS.t]RS.Sym = undef;
                    if (v_iter < 1) {
                        v_mul_a = r_error_xinv;
                        v_mul_b = r_error_xinv;
                    } else if (v_iter < c_half_t) {
                        v_mul_a = r_accum;
                        v_mul_b = r_hold;
                    } else if (v_iter < c_half_t + 1 - RS.fcr) {
                        v_mul_a = r_accum;
                        v_mul_b = r_error_xinv;
                    } else if (v_iter < c_half_t + 1 - RS.fcr + RS.t) {
                        v_mul_a = r_accum;
                        v_mul_b = r_error_xinv;
                    } else {
                        v_mul_a = r_accum;
                        v_mul_b = r_hold;
                    }
                    var v_mul_res: [RS.t]RS.Sym = undef;
                    for (j in 0..RS.t) {
                        v_mul_res[j] = RS.gf_mul(v_mul_a[j], v_mul_b[j]);
                    }
                    if (v_iter < 1) {
                        r_hold = v_mul_res;
                    } else if (v_iter < c_half_t) {
                        for (j in 0..RS.t) {
                            r_accum[j] = v_mul_res[j] ^ r_terms[RS.t + c_half_t - 2];
                        }
                        r_terms[1..RS.t + c_half_t - 1] = r_terms[0..RS.t + c_half_t - 2];
                        r_terms[0] = RS.sym_zero;
                    } else if (v_iter < c_half_t + 1 - RS.fcr) {
                        r_accum = v_mul_res;
                    } else if (v_iter < c_half_t + 1 - RS.fcr + RS.t) {
                        if (v_iter == c_half_t + 1 - RS.fcr) {
                            r_hold = r_accum;
                            v_mul_res = [RS.sym_zero] * v_mul_res.len;
                        }
                        for (j in 0..RS.t) {
                            r_accum[j] = v_mul_res[j] ^ r_terms[RS.t + c_half_t - 2];
                        }
                        r_terms[1..RS.t + c_half_t - 1] = r_terms[0..RS.t + c_half_t - 2];
                        r_terms[0] = RS.sym_zero;
                        val v_index = v_iter - (c_half_t + 1 - RS.fcr);
                        if (r_hold[0] == RS.sym_zero && v_index < r_num_errors) {
                            r_failed = true;
                        }
                        val v_temp = RS.lut_inv[r_hold[0]];
                        r_hold[0..RS.t - 1] = r_hold[1..RS.t];
                        r_hold[RS.t - 1] = v_temp;
                    } else {
                        r_accum = v_mul_res;
                    }
                }
            }
            // update progress counter
            if (r_progress_counter == c_forney_cycles - 1) {
                r_processing = false;
                r_progress_counter = 0;
                r_fc_output_valid = true;
            } else {
                r_progress_counter = r_progress_counter + 1;
            }
        }
        // output data from updated register variables
        if (!r_processing) {
            r_input_ready_cond = true;
            r_input_ready_uncond = !r_fc_output_valid;
        } else {
            r_input_ready_cond = false;
            r_input_ready_uncond = false;
        }
        output.data = RsForneyBlock(unroll_chien, RS=RS).new(
            error_cpos=r_error_cpos,
            error_upos=r_error_upos,
            error_val=r_accum,
            num_errors=r_num_errors,
            failed=r_failed,
        );
        output.valid = r_fc_output_valid;
    }
}
